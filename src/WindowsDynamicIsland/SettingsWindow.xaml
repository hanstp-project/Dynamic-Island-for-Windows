<Window x:Class="WindowsDynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Windows Dynamic Island - Settings"
        Width="580" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI, SF Pro Display"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/Icons/app.ico">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#242428" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#333338" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#99EBEBF5" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="24" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0071E3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0058B6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#3A3A3C" />
            <Setter Property="Foreground" Value="#EBEBF5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#48484A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C2C2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Dynamic Island for Windows" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Configure layout, behavior, and enabled features" FontSize="13" Foreground="#99EBEBF5" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Scrollable Settings List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <!-- Section: Appearance -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Island Style -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Island Style" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Dynamic Island (Melayang) atau Notch (Menempel Bezel Atas)" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="StyleCombo" HorizontalAlignment="Right" Width="190" VerticalAlignment="Center">
                                <ComboBoxItem Content="Dynamic Island (Melayang)" />
                                <ComboBoxItem Content="Notch Island (Bezel Atas)" />
                            </ComboBox>
                        </Grid>

                        <Separator Background="#333338" Margin="0,10" />

                        <!-- Theme -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Color palette for island surfaces" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Right" Width="120" VerticalAlignment="Center">
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Light" />
                            </ComboBox>
                        </Grid>

                        <Separator Background="#333338" Margin="0,10" />

                        <!-- Compact Width -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Compact Width" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Default width in idle pill state" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Slider x:Name="CompactWidthSlider" Grid.Column="1" Minimum="90" Maximum="220" Value="124" SmallChange="1" LargeChange="10" />
                            <TextBlock x:Name="CompactWidthText" Grid.Column="2" Text="{Binding Value, ElementName=CompactWidthSlider, StringFormat='{}{0:0} px'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#99EBEBF5" FontSize="12" />
                        </Grid>

                        <!-- Compact Height -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Compact Height" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Pill height in idle state" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Slider x:Name="CompactHeightSlider" Grid.Column="1" Minimum="26" Maximum="44" Value="32" SmallChange="1" LargeChange="2" />
                            <TextBlock x:Name="CompactHeightText" Grid.Column="2" Text="{Binding Value, ElementName=CompactHeightSlider, StringFormat='{}{0:0} px'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#99EBEBF5" FontSize="12" />
                        </Grid>

                        <!-- Expanded Width -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Expanded Width" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Width when island is expanded" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Slider x:Name="ExpandedWidthSlider" Grid.Column="1" Minimum="320" Maximum="520" Value="380" SmallChange="5" LargeChange="20" />
                            <TextBlock x:Name="ExpandedWidthText" Grid.Column="2" Text="{Binding Value, ElementName=ExpandedWidthSlider, StringFormat='{}{0:0} px'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#99EBEBF5" FontSize="12" />
                        </Grid>

                        <!-- Top Offset -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Top Offset" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Distance from the top of the monitor" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Slider x:Name="TopOffsetSlider" Grid.Column="1" Minimum="0" Maximum="80" Value="8" SmallChange="1" LargeChange="5" />
                            <TextBlock x:Name="TopOffsetText" Grid.Column="2" Text="{Binding Value, ElementName=TopOffsetSlider, StringFormat='{}{0:0} px'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#99EBEBF5" FontSize="12" />
                        </Grid>

                        <!-- Opacity -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pill Opacity" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Surface background transparency" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.6" Maximum="1.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" />
                            <TextBlock x:Name="OpacityText" Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat='{}{0:P0}'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#99EBEBF5" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Features -->
                <TextBlock Text="INTEGRATED FEATURES" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Media Session -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Media Player Integration" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Display current track and controls from Spotify, Browsers, etc." Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="MediaEnabledCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Audio Visualizer -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Music Waveform Visualizer" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Show animated sound bars when music is playing" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="ShowVisualizerCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Compact Synchronized Lyrics -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Running Lyrics in Island / Notch" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Tampilkan lirik lagu berjalan di mode ringkas alih-alih judul saja" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="ShowCompactLyricsCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- System Monitor -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="System Monitor" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="CPU and RAM resource gauges" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="SystemMonitorCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Battery & Network -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Battery &amp; Network Status" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Show battery level and Wi-Fi / Ethernet state" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="BatteryCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Clock & Date -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Clock &amp; Calendar Page" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Show digital clock, date, and clipboard shortcut" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="ClockCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Notifications -->
                <TextBlock Text="NOTIFICATIONS &amp; ALERTS" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Enable Notifications -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Show Island Notifications" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Tampilkan banner notifikasi interaktif di Dynamic Island / Notch" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="NotificationsEnabledCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Mirror Windows Notifications -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Mirror Windows &amp; App Notifications" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Tampilkan pesan dari WhatsApp, Browser, Email, Telegram, Discord &amp; Sistem" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="MirrorWindowsNotificationsCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Notification Timeout Seconds -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Notification Display Duration" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Durasi pesan tampil di island sebelum otomatis kembali (Default: 3 detik)" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Slider x:Name="NotificationTimeoutSlider" Grid.Column="1" Minimum="1" Maximum="10" Value="3" SmallChange="1" LargeChange="1" />
                            <TextBlock x:Name="NotificationTimeoutText" Grid.Column="2" Text="{Binding Value, ElementName=NotificationTimeoutSlider, StringFormat='{}{0:0} s'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#99EBEBF5" FontSize="12" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Test Notification -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Test Notification" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Kirim contoh notifikasi WhatsApp ala macOS ke Dynamic Island" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Button x:Name="TestNotificationButton" Content="Test Notification" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="TestNotificationButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Behavior -->
                <TextBlock Text="BEHAVIOR &amp; GESTURES" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Expand on Hover -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Expand on Hover" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Automatically expand island when mouse hovers over it" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="ExpandOnHoverCheck" HorizontalAlignment="Right" IsChecked="False" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Auto Collapse Seconds -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Auto-Collapse Timeout" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Seconds before returning to compact pill after mouse leaves" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <Slider x:Name="AutoCollapseSlider" Grid.Column="1" Minimum="1" Maximum="30" Value="4" SmallChange="1" LargeChange="5" />
                            <TextBlock x:Name="AutoCollapseText" Grid.Column="2" Text="{Binding Value, ElementName=AutoCollapseSlider, StringFormat='{}{0:0} s'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#99EBEBF5" FontSize="12" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Start with Windows -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Launch automatically on Windows startup" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheck" HorizontalAlignment="Right" IsChecked="False" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Show on All Displays -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Show on All Displays" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Display an independent Dynamic Island on every connected screen" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="ShowOnAllMonitorsCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Hide in Fullscreen -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Hide in Fullscreen" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Automatically hide when playing games or full-screen videos" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="HideInFullscreenCheck" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>

                        <Separator Background="#333338" Margin="0,8" />

                        <!-- Reduced Motion -->
                        <Grid Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="Reduced Motion" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Disable spring bounce and use simple fades" Style="{StaticResource SettingDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="ReducedMotionCheck" HorizontalAlignment="Right" IsChecked="False" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Padding="0,16,0,0" BorderBrush="#333338" BorderThickness="0,1,0,0">
            <Grid>
                <Button x:Name="ResetButton" Content="Reset Defaults" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ResetButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CancelButton_Click" />
                    <Button x:Name="SaveButton" Content="Save Changes" Style="{StaticResource ActionButton}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
