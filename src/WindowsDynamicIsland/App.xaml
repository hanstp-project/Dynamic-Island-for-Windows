<Application x:Class="WindowsDynamicIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:infra="clr-namespace:WindowsDynamicIsland.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Defaults (Apple dark). ThemeManager overwrites these at runtime. -->
        <SolidColorBrush x:Key="Island.Background" Color="#FF000000" />
        <SolidColorBrush x:Key="Island.Background.Solid" Color="#FF000000" />
        <SolidColorBrush x:Key="Island.Edge" Color="#2EFFFFFF" />
        <Color x:Key="Island.Shadow.Color">#FF000000</Color>
        <sys:Double x:Key="Island.Shadow.Opacity">0.45</sys:Double>
        <SolidColorBrush x:Key="Text.Primary" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Text.Secondary" Color="#99EBEBF5" />
        <SolidColorBrush x:Key="Text.Tertiary" Color="#4DEBEBF5" />
        <SolidColorBrush x:Key="Fill.Track" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Fill.Hover" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="Fill.Pressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Fill.Placeholder" Color="#FF2C2C2E" />
        <SolidColorBrush x:Key="Accent.Green" Color="#FF30D158" />
        <SolidColorBrush x:Key="Accent.Blue" Color="#FF0A84FF" />
        <SolidColorBrush x:Key="Accent.Orange" Color="#FFFF9F0A" />
        <SolidColorBrush x:Key="Accent.Red" Color="#FFFF453A" />
        <SolidColorBrush x:Key="Accent.Yellow" Color="#FFFFD60A" />
        <SolidColorBrush x:Key="Accent.Pink" Color="#FFFF375F" />

        <!-- SF Pro is used automatically if installed; otherwise Segoe UI Variable. -->
        <FontFamily x:Key="Font.Display">SF Pro Display, Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="Font.Text">SF Pro Text, Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />

        <!-- Round, borderless control button (media controls, clipboard). -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="20" Background="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Fill.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Fill.Pressed}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style page indicator dot; the active page becomes a short capsule. -->
        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="3,4">
                            <Border x:Name="Dot" Width="6" Height="6" CornerRadius="3"
                                    Background="{DynamicResource Text.Tertiary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Dot" Property="Width" Value="14" />
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple-style Capsule Slider for Brightness (Yellow Accent Track) -->
        <Style x:Key="AppleBrightnessSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#26FFFFFF" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3,0,0,3" Background="{DynamicResource Accent.Yellow}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFFFF">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple-style Capsule Slider for Volume (Blue Accent Track) -->
        <Style x:Key="AppleVolumeSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#26FFFFFF" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3,0,0,3" Background="{DynamicResource Accent.Blue}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFFFF">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
